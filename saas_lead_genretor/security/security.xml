<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_saas_lead_generator" model="ir.module.category">
        <field name="name">SaaS Lead Generator</field>
        <field name="description">Import CRM leads from third-party providers.</field>
        <field name="sequence">110</field>
    </record>

    <record id="res_groups_privilege_saas_lead_generator" model="res.groups.privilege">
        <field name="name">Lead Generator</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="module_category_saas_lead_generator"/>
    </record>

    <record id="group_saas_lead_generator_user" model="res.groups">
        <field name="name">Import Leads</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_saas_lead_generator"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can import third-party leads into CRM.</field>
    </record>

    <record id="group_saas_lead_generator_manager" model="res.groups">
        <field name="name">Configure Lead Integrations</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_saas_lead_generator"/>
        <field name="implied_ids" eval="[(4, ref('group_saas_lead_generator_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="comment">Can configure IndiaMart and other CRM lead integrations.</field>
    </record>

    <record id="rule_crm_third_party_integration_company" model="ir.rule">
        <field name="name">Third Party Integration: company access</field>
        <field name="model_id" ref="model_crm_third_party_integration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_saas_lead_generator_user')), (4, ref('group_saas_lead_generator_manager'))]"/>
    </record>
</odoo>
