<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_import_result_line_list" model="ir.ui.view">
        <field name="name">crm.lead.import.result.line.list</field>
        <field name="model">crm.lead.import.result.line</field>
        <field name="arch" type="xml">
            <list string="Import Results" create="0" edit="0" delete="0"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'"
                  decoration-muted="status == 'skipped'">
                <field name="status"/>
                <field name="name"/>
                <field name="message"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <record id="view_crm_lead_import_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.import.wizard.form</field>
        <field name="model">crm.lead.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Leads">
                <sheet>
                    <group invisible="state != 'draft'">
                        <field name="integration_id" options="{'no_create': True}"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group invisible="state != 'done'">
                        <field name="integration_id" readonly="1"/>
                        <field name="start_date" readonly="1"/>
                        <field name="end_date" readonly="1"/>
                        <field name="message" invisible="not message"/>
                    </group>

                    <group string="Result" invisible="state != 'done'">
                        <field name="success_count"/>
                        <field name="failed_count"/>
                        <field name="skipped_count"/>
                    </group>

                    <field name="result_line_ids" invisible="state != 'done'" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_import"
                            type="object"
                            string="Import"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crm_lead_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Leads</field>
        <field name="res_model">crm.lead.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
