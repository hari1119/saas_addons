<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_inherit_saas_lead_generator" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.saas.lead.generator</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='source_id'])[1]" position="after">
                <field name="third_party_source" readonly="1" invisible="not third_party_source"/>
                <field name="third_party_external_id" readonly="1" invisible="not third_party_external_id"/>
                <field name="third_party_integration_id" readonly="1" invisible="not third_party_integration_id"/>
            </xpath>
        </field>
    </record>
</odoo>
