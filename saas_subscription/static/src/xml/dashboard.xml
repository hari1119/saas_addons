<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="saas_subscription.Dashboard">
        <div class="o_saas_dashboard p-4">

            <!-- Loading state -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center align-items-center" style="height:300px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>

            <!-- Error state -->
            <t t-elif="state.error">
                <div class="alert alert-danger">
                    <strong>Error:</strong> <t t-esc="state.error"/>
                </div>
            </t>

            <!-- Dashboard content -->
            <t t-else="">
                <div class="o_saas_dashboard_header mb-4">
                    <h2 class="fw-bold">
                        <i class="fa fa-dashboard me-2 text-primary"/>
                        SaaS Subscription Dashboard
                    </h2>
                    <p class="text-muted">Real-time overview of all company subscriptions.</p>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_saas_kpi_card"
                             t-on-click="() => this.openByState('active')">
                            <div class="card-body d-flex align-items-center">
                                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                    <i class="fa fa-check-circle fa-2x"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold text-success">
                                        <t t-esc="state.data.active"/>
                                    </div>
                                    <div class="text-muted small">Active Subscriptions</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_saas_kpi_card"
                             t-on-click="() => this.openByState('trial')">
                            <div class="card-body d-flex align-items-center">
                                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                                    <i class="fa fa-hourglass-half fa-2x"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold text-info">
                                        <t t-esc="state.data.trial"/>
                                    </div>
                                    <div class="text-muted small">In Trial</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_saas_kpi_card"
                             t-on-click="() => this.openByState('grace')">
                            <div class="card-body d-flex align-items-center">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                    <i class="fa fa-exclamation-triangle fa-2x"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold text-warning">
                                        <t t-esc="state.data.grace"/>
                                    </div>
                                    <div class="text-muted small">In Grace Period</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_saas_kpi_card"
                             t-on-click="() => this.openByState('expired')">
                            <div class="card-body d-flex align-items-center">
                                <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                                    <i class="fa fa-times-circle fa-2x"/>
                                </div>
                                <div>
                                    <div class="fs-2 fw-bold text-danger">
                                        <t t-esc="state.data.expired"/>
                                    </div>
                                    <div class="text-muted small">Expired</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Revenue + Expiring Soon -->
                <div class="row g-3 mb-4">

                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body text-center">
                                <div class="text-muted small mb-1">Monthly Recurring Revenue</div>
                                <div class="fs-1 fw-bold text-primary">
                                    <t t-esc="state.data.currency_symbol"/>
                                    <t t-esc="state.data.monthly_revenue"/>
                                </div>
                                <div class="text-muted small">(approx., active plans only)</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer o_saas_kpi_card"
                             t-on-click="openExpiring">
                            <div class="card-body text-center">
                                <div class="text-muted small mb-1">Expiring in ≤ 7 Days</div>
                                <div t-attf-class="fs-1 fw-bold
                                    #{state.data.expiring_soon > 0 ? 'text-danger' : 'text-success'}">
                                    <t t-esc="state.data.expiring_soon"/>
                                </div>
                                <div class="text-muted small">subscriptions need attention</div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Revenue by Plan -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 fw-bold">
                        <i class="fa fa-bar-chart me-2 text-primary"/>
                        Revenue by Plan
                    </div>
                    <div class="card-body">
                        <t t-if="state.data.plan_revenue.length === 0">
                            <p class="text-muted text-center">No data available.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Plan</th>
                                        <th class="text-end">Active</th>
                                        <th class="text-end">Revenue</th>
                                        <th>Distribution</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.plan_revenue" t-as="plan" t-key="plan.name">
                                        <tr>
                                            <td><strong><t t-esc="plan.name"/></strong></td>
                                            <td class="text-end"><t t-esc="plan.count"/></td>
                                            <td class="text-end">
                                                <t t-esc="state.data.currency_symbol"/>
                                                <t t-esc="plan.revenue.toFixed(2)"/>
                                            </td>
                                            <td style="width:200px;">
                                                <div class="progress" style="height:10px;">
                                                    <div class="progress-bar bg-primary"
                                                         t-attf-style="width: #{
                                                             state.data.plan_revenue.reduce((s,p)=>s+p.revenue,0) > 0
                                                             ? (plan.revenue / state.data.plan_revenue.reduce((s,p)=>s+p.revenue,0) * 100).toFixed(0)
                                                             : 0
                                                         }%">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>

            </t>
        </div>
    </t>
</templates>
