<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ List ════════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_list" model="ir.ui.view">
        <field name="name">saas.subscription.list</field>
        <field name="model">saas.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'grace' or is_near_expiry"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'trial'"
                  decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="company_id"/>
                <field name="type_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_remaining" string="Days Left"/>
                <field name="grace_end_date"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'expired'"
                       decoration-warning="state == 'grace'"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'trial'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="max_users"/>
                <field name="amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_near_expiry" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══ Form ════════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_form" model="ir.ui.view">
        <field name="name">saas.subscription.form</field>
        <field name="model">saas.subscription</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary"
                            invisible="state not in ('draft','trial')"/>
                    <button name="%(action_saas_subscription_renewal_wizard)d" type="action"
                            string="Renew" class="btn-secondary"
                            invisible="state not in ('active','grace','expired')"/>
                    <button name="action_create_invoice" type="object"
                            string="Create Invoice" class="btn-secondary"
                            invisible="invoice_id != False or state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger"
                            invisible="state in ('cancelled','expired')"
                            confirm="Are you sure you want to cancel this subscription?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,trial,active,grace,expired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_id == False"
                                name="action_create_invoice" type="object">
                            <span class="o_stat_text">Invoice</span>
                        </button>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         invisible="not is_near_expiry or state != 'active'">
                        <strong>⚠️ Expiring Soon!</strong>
                        This subscription expires in <field name="days_remaining" readonly="1"/> days.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'grace'">
                        <strong>🔴 Grace Period Active.</strong>
                        The subscription has expired. Access is still allowed during the grace period.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'expired'">
                        <strong>❌ Subscription Expired.</strong>
                        Company access is now restricted. Please renew immediately.
                    </div>

                    <div class="oe_title">
                        <label for="reference"/>
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Subscription">
                            <field name="company_id"
                                   readonly="state != 'draft'"/>
                            <field name="type_id"
                                   readonly="state not in ('draft','trial')"/>
                            <field name="start_date"
                                   readonly="state not in ('draft','trial')"/>
                            <field name="end_date"/>
                            <field name="trial_end_date"
                                   invisible="not trial_end_date"/>
                        </group>
                        <group string="Status">
                            <field name="grace_end_date"/>
                            <field name="days_remaining"/>
                            <field name="is_near_expiry"/>
                            <field name="is_expired"/>
                        </group>
                    </group>

                    <group>
                        <group string="Billing">
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="payment_gateway" readonly="1"/>
                            <field name="payment_reference"/>
                            <field name="auto_renewal"/>
                        </group>
                        <group string="Feature Snapshot">
                            <field name="max_users"/>
                            <field name="max_storage_gb"/>
                            <field name="grace_period_days"/>
                        </group>
                    </group>

                    <group string="Notification Status">
                        <group>
                            <field name="notified_7days"/>
                            <field name="notified_3days"/>
                        </group>
                        <group>
                            <field name="notified_1day"/>
                            <field name="notified_expired"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Activity Log" name="log">
                            <field name="note" placeholder="Internal notes..."/>
                            <separator string="Activity Log"/>
                            <!-- <field name="env['saas.subscription.log'].search([('subscription_id','=',id)])"
                                   invisible="1"/> -->
                            <list create="false" edit="false" delete="false"
                                  string="Log Entries"
                                  domain="[('subscription_id','=',active_id)]"
                                  model="saas.subscription.log">
                            </list>
                        </page>
                        <page string="Chatter" name="chatter">
                            <chatter/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══ Kanban ══════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_kanban" model="ir.ui.view">
        <field name="name">saas.subscription.kanban</field>
        <field name="model">saas.subscription</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1"
                    class="o_kanban_small_column">
                <field name="reference"/>
                <field name="company_id"/>
                <field name="type_id"/>
                <field name="end_date"/>
                <field name="days_remaining"/>
                <field name="state"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="is_near_expiry"/>
                <templates>
                    <t t-name="card">
                        <t t-set="danger"
                           t-value="record.state.raw_value == 'expired'"/>
                        <t t-set="warning"
                           t-value="record.state.raw_value == 'grace' or record.is_near_expiry.raw_value"/>
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click
                                           #{danger ? 'border-danger' : warning ? 'border-warning' : ''}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong><field name="reference"/></strong><br/>
                                    <span class="text-muted">
                                        <field name="company_id"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge rounded-pill bg-primary">
                                    <field name="type_id"/>
                                </span><br/>
                                <span>Expires: <field name="end_date"/></span><br/>
                                <t t-if="record.days_remaining.raw_value >= 0">
                                    <span t-attf-class="#{record.is_near_expiry.raw_value ? 'text-danger fw-bold' : ''}">
                                        <field name="days_remaining"/> days left
                                    </span>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {
                                               'active': 'success',
                                               'trial': 'info',
                                               'grace': 'warning',
                                               'expired': 'danger',
                                               'cancelled': 'secondary',
                                               'draft': 'secondary'
                                           }}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

