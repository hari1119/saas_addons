    <!-- ═══ Log list (embedded) ═════════════════════════════════════════════ -->
    <record id="view_saas_subscription_log_list" model="ir.ui.view">
        <field name="name">saas.subscription.log.list</field>
        <field name="model">saas.subscription.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  string="Activity Log" default_order="create_date desc">
                <field name="create_date" string="Date"/>
                <field name="user_id" string="By"/>
                <field name="message"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ═══ Actions ═════════════════════════════════════════════════════════ -->
    <record id="action_saas_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">saas.subscription</field>
        <field name="view_mode">list,kanban,form</field>
        <!-- <field name="search_view_id" ref="view_saas_subscription_search"/> -->
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subscriptions yet!
            </p>
            <p>Assign a subscription plan to a company to get started.</p>
        </field>
    </record>

    <record id="action_saas_subscription_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Soon</field>
        <field name="res_model">saas.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','active'),('is_near_expiry','=',True)]</field>
        <field name="context">{'search_default_expiring_soon': 1}</field>
    </record>

    <record id="action_saas_subscription_log" model="ir.actions.act_window">
        <field name="name">Activity Logs</field>
        <field name="res_model">saas.subscription.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
