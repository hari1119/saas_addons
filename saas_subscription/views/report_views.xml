<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription report action -->
    <record id="action_report_saas_subscription" model="ir.actions.act_window">
        <field name="name">Subscription Report</field>
        <field name="res_model">saas.subscription</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{}</field>
    </record>

    <!-- Revenue by plan report -->
    <record id="action_report_saas_revenue" model="ir.actions.act_window">
        <field name="name">Revenue by Plan</field>
        <field name="res_model">saas.subscription</field>
        <field name="view_mode">graph,pivot</field>
        <field name="domain">[('state', '=', 'active')]</field>
        <field name="context">{'group_by': 'type_id'}</field>
    </record>

    <!-- Activity log report -->
    <record id="action_report_saas_logs" model="ir.actions.act_window">
        <field name="name">Activity Logs</field>
        <field name="res_model">saas.subscription.log</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>
</odoo>
