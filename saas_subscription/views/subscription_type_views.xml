<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ List ═══════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_type_list" model="ir.ui.view">
        <field name="name">saas.subscription.type.list</field>
        <field name="model">saas.subscription.type</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" decoration-success="plan_level == 'diamond'"
                  decoration-warning="plan_level == 'gold'"
                  decoration-info="plan_level == 'silver'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="plan_code"/>
                <field name="plan_level"/>
                <field name="duration_value"/>
                <field name="duration_unit"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="max_users"/>
                <field name="max_storage_gb"/>
                <field name="grace_period_days"/>
                <field name="active_subscription_count" string="Active"/>
                <field name="subscription_count" string="Total"/>
            </list>
        </field>
    </record>

    <!-- ═══ Form ════════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_type_form" model="ir.ui.view">
        <field name="name">saas.subscription.type.form</field>
        <field name="model">saas.subscription.type</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <header>
                    <button name="action_view_subscriptions" type="object"
                            string="View Subscriptions" class="btn-secondary"
                            icon="fa-list"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="active_subscription_count"
                                   widget="statinfo" string="Active"/>
                        </button>
                        <button name="action_view_subscriptions" type="object"
                                class="oe_stat_button" icon="fa-list-alt">
                            <field name="subscription_count"
                                   widget="statinfo" string="Total"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Plan Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Gold"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Plan Details">
                            <field name="plan_code"/>
                            <field name="plan_level"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Duration &amp; Grace">
                            <field name="duration_value"/>
                            <field name="duration_unit"/>
                            <field name="grace_period_days"/>
                            <field name="trial_days"/>
                        </group>
                    </group>

                    <group string="Pricing">
                        <group>
                            <field name="currency_id"/>
                            <field name="price" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="setup_fee" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="monthly_revenue" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="payment_gateway"/>
                            <field name="auto_renewal"/>
                        </group>
                    </group>

                    <group string="Feature Limits">
                        <group>
                            <field name="max_users"
                                   help="0 = unlimited"/>
                            <field name="max_storage_gb"
                                   help="0 = unlimited"/>
                            <field name="max_companies"
                                   help="0 = unlimited"/>
                        </group>
                        <group>
                            <field name="custom_domain"/>
                            <field name="api_access"/>
                            <field name="priority_support"/>
                        </group>
                    </group>

                    <group string="Allowed Modules (leave empty = all)">
                        <field name="allowed_modules" widget="many2many_tags"
                               domain="[('state', '=', 'installed')]"
                               nolabel="1"/>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══ Kanban ══════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_type_kanban" model="ir.ui.view">
        <field name="name">saas.subscription.type.kanban</field>
        <field name="model">saas.subscription.type</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="plan_level"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="active_subscription_count"/>
                <field name="max_users"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.value}
                                           oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="plan_level"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span>
                                        <field name="price" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                    <br/>
                                    <span>Max users: <field name="max_users"/></span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        Active:
                                        <strong><field name="active_subscription_count"/></strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══ Search ══════════════════════════════════════════════════════════ -->
    <record id="view_saas_subscription_type_search" model="ir.ui.view">
        <field name="name">saas.subscription.type.search</field>
        <field name="model">saas.subscription.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_code"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_level" string="Plan Level"
                            context="{'group_by': 'plan_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══ Action ══════════════════════════════════════════════════════════ -->
    <record id="action_saas_subscription_type" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">saas.subscription.type</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_saas_subscription_type_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan!
            </p>
            <p>
                Define Gold, Silver, Diamond or any custom plans with pricing,
                feature limits, and duration.
            </p>
        </field>
    </record>

</odoo>
