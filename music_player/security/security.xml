<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_music_player" model="ir.module.category">
        <field name="name">Music Player</field>
        <field name="description">Manage tracks, playlists, and the backend music studio.</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_music_player" model="res.groups.privilege">
        <field name="name">Music Player</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="module_category_music_player"/>
    </record>

    <record id="group_music_player_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_music_player"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can upload, organize, and play music tracks.</field>
    </record>

    <record id="group_music_player_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_music_player"/>
        <field name="implied_ids" eval="[(4, ref('music_player.group_music_player_user'))]"/>
        <field name="comment">Can fully manage the music library and delete records.</field>
    </record>

    <record id="music_track_company_rule" model="ir.rule">
        <field name="name">Music tracks by company</field>
        <field name="model_id" ref="model_music_track"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('music_player.group_music_player_user'))]"/>
    </record>

    <record id="music_playlist_company_rule" model="ir.rule">
        <field name="name">Music playlists by company</field>
        <field name="model_id" ref="model_music_playlist"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('music_player.group_music_player_user'))]"/>
    </record>
</odoo>
