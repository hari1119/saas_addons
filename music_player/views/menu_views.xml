<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_music_studio" model="ir.actions.client">
        <field name="name">Music Studio</field>
        <field name="tag">music_player.music_studio</field>
    </record>

    <menuitem id="menu_music_player_root"
              name="Music Player"
              sequence="95"
              groups="music_player.group_music_player_user"/>

    <delete model="ir.ui.menu" search="[('name', '=', 'Import Audio'), ('parent_id', '=', ref('music_player.menu_music_player_root'))]"/>
    <delete model="ir.actions.act_window" search="[('res_model', '=', 'music.audio.import.wizard')]"/>
    <delete model="ir.ui.view" search="[('model', '=', 'music.audio.import.wizard')]"/>

    <menuitem id="menu_music_player_studio"
              name="Studio"
              parent="menu_music_player_root"
              action="action_music_studio"
              sequence="5"/>

    <menuitem id="menu_music_player_tracks"
              name="Tracks"
              parent="menu_music_player_root"
              action="action_music_track"
              sequence="10"/>

    <menuitem id="menu_music_player_playlists"
              name="Playlists"
              parent="menu_music_player_root"
              action="action_music_playlist"
              sequence="20"/>

    <menuitem id="menu_music_player_configuration"
              name="Configuration"
              parent="menu_music_player_root"
              sequence="90"
              groups="music_player.group_music_player_manager"/>

    <menuitem id="menu_music_player_settings"
              name="Settings"
              parent="menu_music_player_configuration"
              action="action_music_player_settings"
              sequence="10"
              groups="music_player.group_music_player_manager"/>
</odoo>
