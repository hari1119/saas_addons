<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_music_playlist_search" model="ir.ui.view">
        <field name="name">music.playlist.search</field>
        <field name="model">music.playlist</field>
        <field name="arch" type="xml">
            <search string="Music Playlists">
                <field name="name"/>
                <field name="track_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_music_playlist_list" model="ir.ui.view">
        <field name="name">music.playlist.list</field>
        <field name="model">music.playlist</field>
        <field name="arch" type="xml">
            <list string="Music Playlists">
                <field name="name"/>
                <field name="track_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_music_playlist_kanban" model="ir.ui.view">
        <field name="name">music.playlist.kanban</field>
        <field name="model">music.playlist</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="fw-bold text-truncate">
                                <field name="name"/>
                            </div>
                            <div class="text-muted">
                                <field name="track_count"/> tracks
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_music_playlist_form" model="ir.ui.view">
        <field name="name">music.playlist.form</field>
        <field name="model">music.playlist</field>
        <field name="arch" type="xml">
            <form string="Music Playlist">
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_tracks" icon="fa-music">
                            <field name="track_count" widget="statinfo" string="Tracks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Playlist name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Tracks">
                            <field name="track_ids" mode="kanban,list" domain="[('company_id', 'in', [company_id, False])]"/>
                        </page>
                        <page string="Notes">
                            <field name="description" placeholder="Notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_music_playlist" model="ir.actions.act_window">
        <field name="name">Playlists</field>
        <field name="res_model">music.playlist</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_music_playlist_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first playlist
            </p>
        </field>
    </record>
</odoo>
