<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_music_player" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.music.player</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Music Player" string="Music Player" name="music_player" groups="music_player.group_music_player_manager">
                    <block title="Playback">
                        <setting string="Online Mode" help="Use the online endpoint for playback by default. Users can still switch modes in Music Studio.">
                            <field name="music_player_online_mode"/>
                        </setting>
                        <setting string="Receiver Endpoint" help="Remote JSON track-list endpoint used by online mode. Paste another system's shared track list URL here.">
                            <field name="music_player_online_endpoint" placeholder="https://example.com/music_player/share/tracks?token=..." class="w-100"/>
                        </setting>
                    </block>
                    <block title="Sender / Sharing">
                        <setting string="Expose Local Library" help="Allow another system to read and play this system's active tracks through one tokenized URL.">
                            <field name="music_player_share_enabled"/>
                        </setting>
                        <setting string="Share Token" help="Token required by other systems to access this library. Regenerate it to revoke old links.">
                            <field name="music_player_share_token" class="w-100"/>
                            <button name="action_generate_music_player_share_token" type="object" string="Generate Token" icon="fa-refresh" class="btn-link"/>
                        </setting>
                        <setting string="Shared Track List URL" help="Use this URL as the receiver endpoint on another Odoo system.">
                            <field name="music_player_share_url" readonly="1" class="w-100"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_music_player_settings" model="ir.actions.act_window">
        <field name="name">Music Player Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'music_player', 'bin_size': False}</field>
    </record>
</odoo>
