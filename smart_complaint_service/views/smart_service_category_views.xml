<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_service_category_list" model="ir.ui.view">
        <field name="name">smart.service.category.list</field>
        <field name="model">smart.service.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="request_type"/>
                <field name="default_team_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_smart_service_category_form" model="ir.ui.view">
        <field name="name">smart.service.category.form</field>
        <field name="model">smart.service.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="request_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="default_team_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_smart_service_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">smart.service.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
