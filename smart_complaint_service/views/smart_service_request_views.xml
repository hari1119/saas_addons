<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_service_request_list" model="ir.ui.view">
        <field name="name">smart.service.request.list</field>
        <field name="model">smart.service.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="sla_status == 'breached'" decoration-warning="sla_status == 'warning'" decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="category_id"/>
                <field name="priority" widget="priority"/>
                <field name="team_id"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="sla_deadline"/>
                <field name="sla_status" widget="badge" decoration-success="sla_status == 'on_track'" decoration-warning="sla_status == 'warning'" decoration-danger="sla_status == 'breached'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_smart_service_request_kanban" model="ir.ui.view">
        <field name="name">smart.service.request.kanban</field>
        <field name="model">smart.service.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="assigned_user_id"/>
                <field name="sla_status"/>
                <field name="sla_deadline"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="mt-1">
                                <field name="subject"/>
                            </div>
                            <div class="text-muted mt-1">
                                <field name="partner_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <field name="sla_status" widget="badge" decoration-success="sla_status == 'on_track'" decoration-warning="sla_status == 'warning'" decoration-danger="sla_status == 'breached'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_smart_service_request_form" model="ir.ui.view">
        <field name="name">smart.service.request.form</field>
        <field name="model">smart.service.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_triage" type="object" string="Triage" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary" invisible="state not in ('new', 'triage')"/>
                    <button name="action_start" type="object" string="Start Work" class="btn-primary" invisible="state not in ('assigned', 'waiting_customer')"/>
                    <button name="action_waiting_customer" type="object" string="Ask Customer" invisible="state != 'in_progress'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'resolved'"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state not in ('resolved', 'closed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('closed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,triage,assigned,in_progress,waiting_customer,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="subject" placeholder="Short request title"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                        <group string="Classification">
                            <field name="request_type"/>
                            <field name="category_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </group>
                    </group>
                    <group>
                        <group string="Assignment">
                            <field name="team_id"/>
                            <field name="assigned_user_id"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="assigned_date" readonly="1"/>
                        </group>
                        <group string="SLA">
                            <field name="sla_policy_id" readonly="1"/>
                            <field name="sla_deadline" readonly="1"/>
                            <field name="sla_status" widget="badge" readonly="1" decoration-success="sla_status == 'on_track'" decoration-warning="sla_status == 'warning'" decoration-danger="sla_status == 'breached'"/>
                            <field name="resolved_date" readonly="1"/>
                            <field name="closed_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the complaint or service request..."/>
                        </page>
                        <page string="Resolution">
                            <group>
                                <field name="resolution_note" placeholder="What was done to resolve this request?"/>
                                <field name="customer_feedback" readonly="1"/>
                                <field name="rating" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_smart_service_request_search" model="ir.ui.view">
        <field name="name">smart.service.request.search</field>
        <field name="model">smart.service.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="category_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_requests" string="My Requests" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('assigned_user_id', '=', False)]"/>
                <filter name="sla_breached" string="SLA Breached" domain="[('sla_status', '=', 'breached')]"/>
                <filter name="critical" string="Critical" domain="[('priority', '=', '3')]"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ['closed', 'cancelled'])]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_user" string="Assigned User" context="{'group_by': 'assigned_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_smart_service_request" model="ir.actions.act_window">
        <field name="name">Service Requests</field>
        <field name="res_model">smart.service.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first complaint or service request</p>
        </field>
    </record>

    <record id="action_smart_service_request_sla_breached" model="ir.actions.act_window">
        <field name="name">SLA Breached</field>
        <field name="res_model">smart.service.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('sla_status', '=', 'breached')]</field>
    </record>
</odoo>
