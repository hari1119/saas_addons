<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_smart_service" model="ir.module.category">
            <field name="name">Smart Service</field>
            <field name="description">Complaint and service request management.</field>
            <field name="sequence">110</field>
        </record>

        <record id="res_groups_privilege_smart_service" model="res.groups.privilege">
            <field name="name">Smart Service</field>
            <field name="sequence">110</field>
            <field name="category_id" ref="module_category_smart_service"/>
        </record>

        <record id="group_smart_service_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_smart_service"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can manage assigned service requests.</field>
        </record>

        <record id="group_smart_service_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_smart_service"/>
            <field name="implied_ids" eval="[(4, ref('group_smart_service_user'))]"/>
            <field name="comment">Can manage all service requests and configuration.</field>
        </record>

        <record id="rule_service_request_user" model="ir.rule">
            <field name="name">Smart Service Request: assigned or team member</field>
            <field name="model_id" ref="model_smart_service_request"/>
            <field name="domain_force">['|', ('assigned_user_id', '=', user.id), ('team_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_smart_service_user'))]"/>
        </record>

        <record id="rule_service_request_manager" model="ir.rule">
            <field name="name">Smart Service Request: managers see all</field>
            <field name="model_id" ref="model_smart_service_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_smart_service_manager'))]"/>
        </record>

        <record id="rule_service_request_portal" model="ir.rule">
            <field name="name">Smart Service Request: portal own requests</field>
            <field name="model_id" ref="model_smart_service_request"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
    </data>
</odoo>
