<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="partner_demo_acme" model="res.partner">
            <field name="name">Acme Industries</field>
            <field name="email">ops@acme.example</field>
            <field name="phone">+1 555 0100</field>
        </record>

        <record id="partner_demo_zenith" model="res.partner">
            <field name="name">Zenith Retail</field>
            <field name="email">support@zenith.example</field>
            <field name="phone">+1 555 0200</field>
        </record>

        <record id="team_customer_support" model="smart.service.team">
            <field name="name">Customer Support Team</field>
            <field name="sequence">10</field>
            <field name="manager_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="team_field_service" model="smart.service.team">
            <field name="name">Field Service Team</field>
            <field name="sequence">20</field>
            <field name="manager_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="team_billing_support" model="smart.service.team">
            <field name="name">Billing Support Team</field>
            <field name="sequence">30</field>
            <field name="manager_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="category_product_complaint" model="smart.service.category">
            <field name="name">Product Complaint</field>
            <field name="request_type">complaint</field>
            <field name="default_team_id" ref="team_customer_support"/>
        </record>

        <record id="category_installation_request" model="smart.service.category">
            <field name="name">Installation Request</field>
            <field name="request_type">service</field>
            <field name="default_team_id" ref="team_field_service"/>
        </record>

        <record id="category_maintenance_request" model="smart.service.category">
            <field name="name">Maintenance Request</field>
            <field name="request_type">service</field>
            <field name="default_team_id" ref="team_field_service"/>
        </record>

        <record id="category_billing_complaint" model="smart.service.category">
            <field name="name">Billing Complaint</field>
            <field name="request_type">complaint</field>
            <field name="default_team_id" ref="team_billing_support"/>
        </record>

        <record id="category_warranty_claim" model="smart.service.category">
            <field name="name">Warranty Claim</field>
            <field name="request_type">service</field>
            <field name="default_team_id" ref="team_customer_support"/>
        </record>

        <record id="sla_critical_complaint" model="smart.service.sla">
            <field name="name">Critical Complaint - 4 Hours</field>
            <field name="category_id" ref="category_product_complaint"/>
            <field name="priority">3</field>
            <field name="response_hours">1</field>
            <field name="resolution_hours">4</field>
        </record>

        <record id="sla_high_billing" model="smart.service.sla">
            <field name="name">High Billing Complaint - 8 Hours</field>
            <field name="category_id" ref="category_billing_complaint"/>
            <field name="priority">2</field>
            <field name="response_hours">2</field>
            <field name="resolution_hours">8</field>
        </record>

        <record id="sla_normal_service" model="smart.service.sla">
            <field name="name">Normal Service Request - 24 Hours</field>
            <field name="priority">1</field>
            <field name="response_hours">4</field>
            <field name="resolution_hours">24</field>
        </record>

        <record id="sla_low_request" model="smart.service.sla">
            <field name="name">Low Request - 48 Hours</field>
            <field name="priority">0</field>
            <field name="response_hours">8</field>
            <field name="resolution_hours">48</field>
        </record>

        <record id="request_product_not_working" model="smart.service.request">
            <field name="subject">Product not working after delivery</field>
            <field name="partner_id" ref="partner_demo_acme"/>
            <field name="email">ops@acme.example</field>
            <field name="phone">+1 555 0100</field>
            <field name="request_type">complaint</field>
            <field name="category_id" ref="category_product_complaint"/>
            <field name="priority">3</field>
            <field name="team_id" ref="team_customer_support"/>
            <field name="assigned_user_id" ref="base.user_admin"/>
            <field name="state">in_progress</field>
            <field name="submitted_date">2026-07-01 09:00:00</field>
            <field name="description">Customer reports the product stopped working during first usage. Needs immediate replacement assessment.</field>
        </record>

        <record id="request_installation_required" model="smart.service.request">
            <field name="subject">Installation required for new site</field>
            <field name="partner_id" ref="partner_demo_zenith"/>
            <field name="email">support@zenith.example</field>
            <field name="phone">+1 555 0200</field>
            <field name="request_type">service</field>
            <field name="category_id" ref="category_installation_request"/>
            <field name="priority">1</field>
            <field name="team_id" ref="team_field_service"/>
            <field name="assigned_user_id" ref="base.user_admin"/>
            <field name="state">assigned</field>
            <field name="assigned_date">2026-07-03 10:00:00</field>
            <field name="submitted_date">2026-07-03 09:30:00</field>
            <field name="description">New equipment has arrived and the customer wants field installation scheduled.</field>
        </record>

        <record id="request_billing_mismatch" model="smart.service.request">
            <field name="subject">Billing amount mismatch</field>
            <field name="partner_id" ref="partner_demo_acme"/>
            <field name="email">finance@acme.example</field>
            <field name="phone">+1 555 0101</field>
            <field name="request_type">complaint</field>
            <field name="category_id" ref="category_billing_complaint"/>
            <field name="priority">2</field>
            <field name="team_id" ref="team_billing_support"/>
            <field name="assigned_user_id" ref="base.user_admin"/>
            <field name="state">in_progress</field>
            <field name="submitted_date">2026-07-03 08:00:00</field>
            <field name="description">Invoice amount does not match the approved quotation. Customer is waiting for correction.</field>
        </record>

        <record id="request_warranty_claim" model="smart.service.request">
            <field name="subject">Warranty claim for damaged unit</field>
            <field name="partner_id" ref="partner_demo_zenith"/>
            <field name="email">support@zenith.example</field>
            <field name="phone">+1 555 0200</field>
            <field name="request_type">service</field>
            <field name="category_id" ref="category_warranty_claim"/>
            <field name="priority">1</field>
            <field name="team_id" ref="team_customer_support"/>
            <field name="assigned_user_id" ref="base.user_admin"/>
            <field name="state">resolved</field>
            <field name="submitted_date">2026-07-02 10:00:00</field>
            <field name="resolved_date">2026-07-03 11:00:00</field>
            <field name="description">Customer submitted warranty claim for a damaged unit.</field>
            <field name="resolution_note">Warranty approved and replacement dispatch initiated.</field>
            <field name="rating">4</field>
            <field name="customer_feedback">Fast response and clear communication.</field>
        </record>
    </data>
</odoo>
